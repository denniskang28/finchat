DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/semantic_rag
UPLOAD_DIR=/app/data/uploads
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# LLM-primary page parsing with token-verified pdfplumber evidence and fallback repair.
TABLE_REPAIR_ENABLED=true
TABLE_PARSE_MODE=llm_primary
TABLE_PARSE_WORKERS=4
TABLE_REPAIR_PROVIDER=alibaba
TABLE_REPAIR_TIMEOUT_SECONDS=90
DASHSCOPE_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_VISION_MODEL=qwen3.8-flash
ALIBABA_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
ALIBABA_EMBEDDING_DIMENSIONS=1024
ALIBABA_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
ALIBABA_RERANK_MODEL=qwen3.7-text-rerank
ALIBABA_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
ALIBABA_EVALUATION_MODEL=qwen3.8-flash
ALIBABA_GENERATION_MODELS=qwen3.8-flash

# DeepSeek multimodal parsing option.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_GENERATION_MODELS=deepseek-chat

# Future provider option: set TABLE_REPAIR_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_VISION_MODEL=

# Durable PostgreSQL ingestion worker.
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3
